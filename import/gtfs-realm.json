{
  "realm": "gtfs",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access to admin panel" },
      { "name": "user",  "description": "Standard user access" }
    ]
  },
  "clients": [
    {
      "clientId": "gtfs-admin",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "gtfs-admin-secret-key-do-not-share",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "gtfs-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:5173/*",
        "http://localhost:3001",
        "http://localhost:5173"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:5173",
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "[\"http://localhost:3001\",\"http://localhost:5173\"]"
      }
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "email": "superadmin@gtfs.local",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dba",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ],
  "scopeMappings": [
    {
      "client": "gtfs-admin",
      "roles": ["admin"]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "gtfs-admin",
        "roles": ["manage-users", "view-users", "manage-realm", "view-realm"]
      }
    ]
  }
}
