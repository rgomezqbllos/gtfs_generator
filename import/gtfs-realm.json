{
  "realm": "gtfs",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access to admin panel" },
      { "name": "user",  "description": "Standard user access" }
    ]
  },
  "clients": [
    {
      "clientId": "gtfs-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:5173/*",
        "http://localhost:3001",
        "http://localhost:5173"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:5173",
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "[\"http://localhost:3001\",\"http://localhost:5173\"]"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@gtfs.local",
      "firstName": "Admin",
      "lastName": "GTFS",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
