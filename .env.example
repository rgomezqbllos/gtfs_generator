# ============================================================
# GTFS Generator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Keycloak Admin Credentials (REQUIRED) ---
# Used by the app service to manage users via Keycloak Admin API.
# Must match the credentials configured in the Keycloak service below.
KEYCLOAK_ADMIN=superadmin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# --- Keycloak Admin Client (REQUIRED) ---
# Service account client for programmatic user management
# Must match the client configured in gtfs-realm.json
KEYCLOAK_ADMIN_CLIENT_ID=gtfs-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=gtfs-admin-secret-key-do-not-share

# --- PostgreSQL / Keycloak DB (REQUIRED) ---
# Shared between the keycloak and postgres services.
KC_DB_PASSWORD=change_me_in_production
POSTGRES_USER=keycloak

# --- CORS (Optional) ---
# Comma-separated list of allowed frontend origins.
# Leave unset to allow all origins (development only).
# Example: ALLOWED_ORIGINS=https://gtfs.mycompany.com,https://app.mycompany.com
ALLOWED_ORIGINS=http://localhost:5173

# --- OSRM (Optional) ---
# Override the base URL where OSRM containers are reachable from the backend.
# Defaults to http://host.docker.internal when running inside Docker.
# OSRM_BASE_URL=http://host.docker.internal

# Docker network name used for OSRM containers. Must match docker-compose service network.
# OSRM_DOCKER_NETWORK=gtfs_generator_default

# Number of threads for each osrm-routed instance (default: 2).
# OSRM_ROUTED_THREADS=2

# --- Security (Optional) ---
# Set to 'true' ONLY for internal/mirror downloads with self-signed TLS certs.
# Defaults to false (secure) in all environments.
# ALLOW_INSECURE_DOWNLOADS=false

# --- App (Optional) ---
# Server port (default: 3001).
# PORT=3001

# Path to the SQLite database file inside the container (default: /data/gtfs.db).
# DB_PATH=/data/gtfs.db

# Set to 'production' to suppress verbose SQL query logging.
# NODE_ENV=production
